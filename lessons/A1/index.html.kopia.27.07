<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>A1 – Lekcje</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="../../css/style.css">

<style>

body{
    font-family:system-ui,sans-serif;
    background:#0f172a;
    color:#f9fafb;
    margin:0;
    padding:40px 20px;
    text-align:center;
}

/* ===== PRZYCISK A–Z ===== */

.top-bar{
    width:900px;
    max-width:100%;
    margin:0 auto 10px;
    display:flex;
    justify-content:flex-start;
}

.aza1-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    background:#1d3557;
    color:#ffce00;

    border:3px solid #ffce00;
    border-radius:999px;

    padding:12px 26px;

    font-size:28px;
    font-weight:900;

    text-decoration:none;

    box-shadow:0 8px 20px rgba(0,0,0,.35);

    transition:
        background .3s ease,
        color .3s ease,
        transform .3s ease;
}

.aza1-btn:hover{
    background:#274c77;
    color:#ffffff;
    transform:translateY(-3px) scale(1.05);
}

/* ===== NUMERY LEKCJI ===== */

.lesson-list{
    width:900px;
    max-width:100%;
    margin:30px auto;

    display:grid;
    grid-template-columns:repeat(10,1fr);

    gap:10px;
}

.lesson-link{
    display:flex;
    justify-content:center;
    align-items:center;

    width:60px;
    height:45px;

    margin:auto;

    border-radius:12px;

    background:#1f2937;
    color:#34d399;

    text-decoration:none;

    font-size:18px;
    font-weight:bold;

    border:2px solid #34d399;

    transition:.2s;
}

.lesson-link:hover{
    background:#022c22;
    transform:scale(1.08);
}

/* ===== SPRICH NACH ===== */

.sprich-button{
    display:inline-block;

    margin-top:25px;
    padding:14px 40px;

    background:#2563eb;
    color:white;

    text-decoration:none;

    font-size:22px;
    font-weight:bold;

    border-radius:18px;
    border:2px solid #60a5fa;

    transition:.2s;
}

.sprich-button:hover{
    background:#1d4ed8;
    transform:scale(1.05);
}

/* ===== AKTIV TRAINIEREN ===== */

.train-button{
    display:inline-block;

    margin-top:20px;
    padding:14px 40px;

    background:#16a34a;
    color:white;

    text-decoration:none;

    font-size:22px;
    font-weight:bold;

    border-radius:18px;
    border:2px solid #4ade80;

    transition:.2s;
}

.train-button:hover{
    background:#15803d;
    transform:scale(1.05);
}

.info{
    margin-top:30px;
    font-size:18px;
    line-height:1.7;
}

.back-links{
    margin-top:35px;
}

.back-links a{
    color:#93c5fd;
    text-decoration:none;
    margin:0 10px;
}

/* ===== TELEFON I TABLET ===== */

@media (max-width:950px){

    .lesson-list{
        grid-template-columns:repeat(5,1fr);
        width:100%;
    }

    .top-bar{
        width:100%;
    }
}

@media (max-width:520px){

    body{
        padding:25px 12px;
    }

    .lesson-list{
        grid-template-columns:repeat(4,1fr);
    }

    .lesson-link{
        width:52px;
        height:42px;
    }

    .aza1-btn{
        font-size:22px;
        padding:10px 20px;
    }
}

</style>

</head>

<body>

<div class="top-bar">
    <a href="A-Z-A1.html" class="aza1-btn">A–Z</a>
</div>

