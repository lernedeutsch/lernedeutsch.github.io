<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Lektion 1 – Begrüßung und Vorstellung</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Fraunces:wght@500;700&family=Nunito+Sans:opsz,wght@6..12,400,600,700,800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --ink:#16233a;
  --line:#e3d6b8;
  --red:#bd4433;
  --gold:#cf9f3f;
  --green:#4f7a63;
  --dark-green:#315f4c;
  --text:#1c2430;
  --informell:#58755f;
  --formell:#a65e4f;
  --bubble-a:#eee9dc;
  --bubble-b:#e8c989;
  --success:#16864b;
  --success-bg:#e8f8ef;
  --error:#c53d3d;
  --error-bg:#fff0f0
}

*{box-sizing:border-box}

html{scroll-behavior:smooth}

body{
  margin:0;
  min-height:100vh;
  padding:45px 20px 60px;
  color:var(--text);
  font:400 1rem/1.6 "Nunito Sans",sans-serif;
  background:
    radial-gradient(circle at 10% 8%,rgba(207,159,63,.07),transparent 35%),
    radial-gradient(circle at 90% 92%,rgba(79,122,99,.1),transparent 40%),
    var(--ink)
}

button{
  font:inherit;
  cursor:pointer
}

/* ==================================================
   PASEK POSTĘPU STRONY
================================================== */

.page-progress-container{
  position:fixed;
  z-index:1000;
  top:0;
  left:0;
  width:100%;
  height:7px;
  background:rgba(255,255,255,.16)
}

.page-progress-bar{
  width:0;
  height:100%;
  background:linear-gradient(90deg,#f4c95d,#ffb54a);
  transition:width .2s ease
}

/* ==================================================
   WSPÓLNE STRONY
================================================== */

.page{
  width:100%;
  margin:0 auto 38px;
  background:linear-gradient(160deg,#fff8ea,#f3e2bd);
  border-radius:24px;
  box-shadow:0 24px 55px rgba(0,0,0,.25)
}

.greeting-page{
  max-width:980px;
  padding:34px
}

.intro-page{
  max-width:860px;
  padding:24px 28px 30px;
  border:1px solid rgba(227,214,184,.8);
  border-radius:20px;
  box-shadow:0 18px 42px rgba(0,0,0,.28)
}

.exercise-page{
  max-width:900px;
  padding:22px
}

.part-head{
  display:flex;
  flex-wrap:wrap;
  align-items:baseline;
  gap:14px;
  margin-bottom:18px
}

.part-num{
  color:var(--red);
  font:600 .82rem "JetBrains Mono",monospace;
  letter-spacing:.16em;
  text-transform:uppercase
}

.part-title{
  margin:0;
  color:#161616;
  font:700 2.5rem/1.15 "Kalam",cursive
}

.intro-page .part-head{
  margin-bottom:17px;
  padding-bottom:9px;
  border-bottom:1px solid rgba(28,36,48,.12)
}

.intro-page .part-num{
  font-size:.72rem
}

.intro-page .part-title{
  font-size:2.15rem
}

.card{
  background:#fffdf6;
  border:1px solid var(--line);
  box-shadow:0 12px 30px rgba(0,0,0,.07)
}

/* ==================================================
   TEIL 1 – BEGRÜSSUNG
================================================== */

.greeting-card{
  padding:28px;
  border-radius:24px
}

.lead{
  margin:0 0 22px;
  font-size:1.08rem
}

.grammar-toggle{
  margin:0 0 26px
}

.grammar-toggle summary{
  padding:15px 18px;
  cursor:pointer;
  list-style:none;
  background:#f0ede0;
  border:1px solid var(--line);
  border-radius:15px;
  font-weight:800
}

.grammar-toggle summary::-webkit-details-marker{
  display:none
}

.grammar-toggle summary::before{
  content:"📖 "
}

.grammar-toggle[open] summary{
  border-radius:15px 15px 0 0
}

.grammar-box{
  padding:18px;
  background:#fbf6e8;
  border:1px solid var(--line);
  border-top:0;
  border-left:4px solid var(--gold);
  border-radius:0 0 15px 15px
}

.greeting-game{
  padding:26px;
  background:#fbf6e8;
  border:1px solid var(--line);
  border-radius:20px
}

.clock-display{
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:26px
}

.day-picture{
  position:relative;
  display:grid;
  place-items:center;
  flex:0 0 92px;
  width:92px;
  height:72px;
  overflow:hidden;
  border:2px solid rgba(28,36,48,.12);
  border-radius:16px;
  box-shadow:
    0 8px 18px rgba(0,0,0,.16),
    inset 0 1px 0 rgba(255,255,255,.35);
  transition:background .35s,transform .35s
}

.day-picture::after{
  content:"";
  position:absolute;
  right:-10px;
  bottom:-16px;
  width:115px;
  height:38px;
  background:rgba(255,255,255,.22);
  border-radius:50%
}

.day-picture.morgen{
  background:linear-gradient(
    180deg,
    #e95f42,
    #ff9b42 50%,
    #3971b8 51%,
    #204d8c
  )
}

.day-picture.tag{
  background:linear-gradient(
    180deg,
    #74c9ff,
    #bce9ff 62%,
    #6ebf61 63%,
    #3d914d
  )
}

.day-picture.abend{
  background:linear-gradient(
    180deg,
    #111b4a,
    #303b78 58%,
    #65416f 59%,
    #2b284e
  )
}

.day-symbol{
  position:relative;
  z-index:1;
  font-size:2.6rem;
  line-height:1;
  filter:drop-shadow(0 3px 3px rgba(0,0,0,.18));
  transition:transform .35s
}

.clock-time{
  font:700 1.8rem "JetBrains Mono",monospace
}

.question{
  margin:0 0 10px;
  font-size:1.08rem
}

.answer-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:14px
}

.answer-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  padding:11px 19px;
  color:var(--text);
  background:#fff;
  border:2px solid var(--line);
  border-radius:999px;
  font:800 .98rem "Nunito Sans",sans-serif;
  transition:.15s
}

.answer-button:hover:not(:disabled){
  transform:translateY(-2px);
  border-color:var(--gold);
  box-shadow:0 6px 14px rgba(0,0,0,.08)
}

.answer-button:disabled{
  cursor:default
}

.answer-button.richtig{
  color:#28502f;
  background:#e4f3e8;
  border-color:var(--green)
}

.answer-button.falsch{
  color:var(--red);
  background:#f9e4e1;
  border-color:var(--red)
}

.click-icon{
  font-size:1.05em;
  line-height:1
}

.feedback{
  min-height:30px;
  margin:10px 0 0;
  font-size:1rem;
  font-weight:800
}

.counter{
  margin:12px 0 0;
  color:#5a5140;
  font:.88rem "JetBrains Mono",monospace
}

.progress-area{
  margin-top:18px
}

.progress-track{
  height:12px;
  overflow:hidden;
  background:#e8dfca;
  border:1px solid var(--line);
  border-radius:999px
}

.progress-fill{
  width:0;
  height:100%;
  background:linear-gradient(90deg,#5f9e6e,#79bd84);
  border-radius:999px;
  transition:width .5s
}

.finish{
  display:none;
  margin-top:20px;
  padding:18px;
  color:#28502f;
  text-align:center;
  background:#e4f3e8;
  border:2px solid var(--green);
  border-radius:16px
}

.finish.zeigen{
  display:block;
  animation:fadeIn .45s ease
}

.finish-title{
  display:block;
  margin-bottom:5px;
  font-size:1.18rem;
  font-weight:800
}

.restart-button,
.read-button{
  color:#fff;
  background:var(--green);
  border:0;
  border-radius:999px;
  font:800 .95rem "Nunito Sans",sans-serif
}

.restart-button{
  margin-top:14px;
  padding:10px 20px
}

.restart-button:hover,
.read-button:hover{
  filter:brightness(1.08)
}

@keyframes fadeIn{
  from{
    opacity:0;
    transform:translateY(8px)
  }

  to{
    opacity:1;
    transform:translateY(0)
  }
}

/* ==================================================
   TEIL 2 – DIALOG
================================================== */

.description{
  margin:0 0 14px;
  font-size:1rem;
  line-height:1.45
}

.name-row{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:17px
}

.name-row label{
  display:inline-flex;
  align-items:center;
  gap:7px;
  flex:none;
  font-size:.96rem;
  font-weight:800
}

.name-row input{
  flex:1;
  min-width:0;
  padding:10px 14px;
  color:var(--text);
  background:#fff;
  border:2px solid var(--line);
  border-radius:11px;
  font:400 .96rem "Nunito Sans",sans-serif;
  transition:border-color .18s,box-shadow .18s
}

.name-row input:focus{
  outline:none;
  border-color:var(--gold);
  box-shadow:0 0 0 4px rgba(207,159,63,.16)
}

.tab-buttons{
  display:flex;
  align-items:center;
  gap:76px;
  margin-bottom:15px
}

.tab-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-width:122px;
  padding:9px 20px;
  color:#3b3026;
  background:#f5efe1;
  border:2px solid var(--line);
  border-radius:9px;
  font:800 .92rem "Nunito Sans",sans-serif;
  transition:.16s
}

.tab-button:hover{
  transform:translateY(-2px);
  border-color:var(--gold);
  box-shadow:0 5px 12px rgba(0,0,0,.1)
}

#tab-informell.active{
  color:#fff;
  background:var(--informell);
  border-color:#46614e;
  box-shadow:0 5px 12px rgba(70,97,78,.25)
}

#tab-formell.active{
  color:#fff;
  background:var(--formell);
  border-color:#8f4c40;
  box-shadow:0 5px 12px rgba(143,76,64,.25)
}

.dialog-box{
  display:grid;
  gap:14px;
  min-height:330px;
  padding:19px 18px;
  background:rgba(255,255,255,.34);
  border:2px solid var(--line);
  border-radius:16px
}

.dialog-box[hidden]{
  display:none
}

.bubble{
  position:relative;
  padding:11px 16px;
  color:#171717;
  border-radius:15px;
  font-size:1rem;
  line-height:1.45;
  box-shadow:0 4px 10px rgba(0,0,0,.045);
  transition:
    transform .18s,
    box-shadow .18s,
    border-color .18s,
    padding .18s
}

.bubble-a{
  width:72%;
  max-width:580px;
  margin-right:auto;
  background:var(--bubble-a);
  border:1px solid #e2dccd;
  border-bottom-left-radius:7px
}

.bubble-b{
  width:40%;
  min-width:220px;
  max-width:330px;
  margin-left:auto;
  background:linear-gradient(145deg,#f0d89f,var(--bubble-b));
  border:1px solid #d2a94f;
  border-bottom-right-radius:7px;
  box-shadow:0 6px 13px rgba(153,109,25,.15)
}

.speaker{
  display:block;
  margin-bottom:3px;
  color:var(--red);
  font:600 .65rem "JetBrains Mono",monospace;
  letter-spacing:.12em;
  text-transform:uppercase
}

.person-icon{
  position:absolute;
  top:50%;
  display:grid;
  place-items:center;
  width:34px;
  height:34px;
  background:#fffaf0;
  border-radius:10px;
  font-size:1.25rem;
  opacity:0;
  pointer-events:none;
  transform:translateY(-50%) scale(.55);
  transition:opacity .2s,transform .2s;
  box-shadow:0 4px 10px rgba(0,0,0,.1)
}

.bubble-a .person-icon{
  right:13px;
  border:1px solid rgba(79,122,99,.32)
}

.bubble-b .person-icon{
  left:13px;
  border:1px solid rgba(189,68,51,.28)
}

.bubble-a.speaking{
  padding-right:60px;
  border-color:#7a9b83;
  transform:translateY(-1px);
  box-shadow:0 7px 16px rgba(49,95,76,.15)
}

.bubble-b.speaking{
  padding-left:60px;
  border-color:#c59036;
  transform:translateY(-1px);
  box-shadow:0 8px 18px rgba(153,109,25,.23)
}

.bubble.speaking .person-icon{
  opacity:1;
  transform:translateY(-50%) scale(1)
}

.read-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  margin-top:13px;
  padding:9px 19px;
  background:linear-gradient(#3e755e,var(--dark-green));
  font-size:.9rem;
  box-shadow:0 6px 13px rgba(49,95,76,.24);
  transition:.16s
}

.read-button:hover{
  transform:translateY(-2px);
  box-shadow:0 9px 16px rgba(49,95,76,.3)
}

.read-button:disabled{
  cursor:not-allowed;
  opacity:.65;
  transform:none
}

/* ==================================================
   TEIL 3 – INFORMELL ODER FORMELL?
================================================== */

.exercise-card{
  padding:22px;
  background:linear-gradient(145deg,#fff8e9,#f5e6c7);
  border:1px solid rgba(255,255,255,.4);
  border-radius:22px;
  box-shadow:0 18px 45px rgba(0,0,0,.16)
}

.exercise-read-button{
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-height:42px;
  margin:0 0 20px;
  padding:8px 18px;
  color:#fff;
  background:linear-gradient(#5e8d72,#3f6c56);
  border:1px solid #315b47;
  border-radius:999px;
  font-weight:800;
  box-shadow:0 7px 15px rgba(49,91,71,.22);
  transition:.15s
}

.exercise-read-button:hover{
  transform:translateY(-2px);
  filter:brightness(1.06)
}

.exercise-read-button.speaking{
  background:#315f4c
}

.exercise-title{
  margin:0 0 15px;
  font:700 1.7rem/1.2 "Fraunces",serif
}

.category-buttons{
  display:flex;
  gap:10px;
  margin:0 0 17px
}

.category-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-width:120px;
  min-height:41px;
  padding:7px 17px;
  color:var(--text);
  background:#fbf5e8;
  border:2px solid var(--line);
  border-radius:999px;
  font-weight:800;
  transition:.15s
}

.category-button:hover:not(:disabled){
  border-color:var(--gold);
  transform:translateY(-2px)
}

.category-button.correct-choice{
  color:#fff;
  background:var(--success);
  border-color:var(--success)
}

.category-button.wrong-choice{
  color:#fff;
  background:var(--error);
  border-color:var(--error)
}

.category-button:disabled{
  cursor:default;
  opacity:.55
}

.exercise-list{
  display:grid;
  gap:9px
}

.exercise-row{
  display:grid;
  grid-template-columns:minmax(0,1fr);
  gap:5px;
  min-height:58px;
  padding:10px 14px;
  overflow-x:auto;
  background:rgba(255,255,255,.93);
  border:2px solid var(--line);
  border-radius:16px;
  opacity:.65;
  transition:
    border-color .2s,
    background .2s,
    box-shadow .2s,
    transform .2s,
    opacity .2s
}

.exercise-row.active{
  opacity:1;
  background:#fffdf5;
  border-color:var(--gold);
  box-shadow:
    0 0 0 4px rgba(207,159,63,.2),
    0 8px 18px rgba(77,60,30,.13);
  transform:scale(1.01)
}

.exercise-row.solved{
  opacity:1;
  background:var(--success-bg);
  border-color:#78bf95;
  box-shadow:none;
  transform:none
}

.exercise-row.wrong{
  opacity:1;
  background:var(--error-bg);
  border-color:#e79a9a;
  animation:shake .28s
}

.exercise-sentence{
  white-space:nowrap;
  font-size:1.08rem;
  font-weight:800
}

.exercise-feedback{
  min-height:0;
  margin:0;
  font-size:.84rem;
  font-weight:800
}

.exercise-feedback.good{
  color:var(--success)
}

.exercise-feedback.bad{
  color:var(--error)
}

@keyframes shake{
  25%{transform:translateX(-4px)}
  75%{transform:translateX(4px)}
}

.exercise-result{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-top:16px;
  padding:12px 15px;
  background:rgba(255,255,255,.7);
  border:1px solid var(--line);
  border-radius:14px
}

.exercise-score{
  margin:0;
  font:600 .9rem "JetBrains Mono",monospace
}

.exercise-score strong{
  font-size:1.05rem
}

.exercise-reset{
  min-height:38px;
  padding:7px 15px;
  color:#fff;
  background:#20324a;
  border:0;
  border-radius:999px;
  font-weight:800;
  transition:.15s
}

.exercise-reset:hover{
  transform:translateY(-2px);
  filter:brightness(1.1)
}

.exercise-complete{
  min-height:24px;
  margin:12px 0 0;
  color:var(--success);
  text-align:center;
  font-weight:800
}

/* ==================================================
   DOSTĘPNOŚĆ
================================================== */

button:focus-visible,
summary:focus-visible,
input:focus-visible{
  outline:3px solid var(--gold);
  outline-offset:3px
}

/* ==================================================
   TELEFON
================================================== */

@media(max-width:700px){
  body{
    padding:20px 12px 35px
  }

  .greeting-page{
    padding:20px 14px;
    border-radius:18px
  }

  .greeting-page .part-title{
    font-size:2rem
  }

  .greeting-card{
    padding:18px 14px
  }

  .greeting-game{
    padding:20px 14px
  }

  .clock-display{
    gap:14px;
    margin-bottom:22px
  }

  .day-picture{
    flex-basis:76px;
    width:76px;
    height:62px
  }

  .day-symbol{
    font-size:2.2rem
  }

  .clock-time{
    font-size:1.45rem
  }

  .answer-buttons{
    flex-direction:column
  }

  .answer-button{
    width:100%
  }

  .intro-page{
    padding:20px 13px 24px;
    border-radius:15px
  }

  .intro-page .part-head{
    gap:9px
  }

  .intro-page .part-title{
    font-size:1.78rem
  }

  .intro-card{
    padding:18px 13px
  }

  .name-row{
    align-items:stretch;
    flex-direction:column;
    gap:7px
  }

  .tab-buttons{
    gap:35px
  }

  .tab-button{
    min-width:115px;
    padding:9px 12px
  }

  .dialog-box{
    min-height:0;
    padding:16px 11px;
    gap:13px
  }

  .bubble-a{
    width:82%
  }

  .bubble-b{
    width:58%;
    min-width:0
  }

  .exercise-page{
    padding:17px 12px;
    border-radius:18px
  }

  .exercise-read-button{
    width:100%;
    justify-content:center
  }

  .exercise-title{
    font-size:1.45rem
  }

  .category-buttons{
    display:grid;
    grid-template-columns:1fr 1fr
  }

  .category-button{
    min-width:0
  }

  .exercise-row{
    padding:10px 12px
  }

  .exercise-sentence{
    font-size:1rem
  }

  .exercise-result{
    align-items:stretch;
    flex-direction:column
  }

  .exercise-reset{
    width:100%
  }
}

@media(max-width:430px){
  .intro-page .part-head{
    display:block
  }

  .intro-page .part-num{
    display:block;
    margin-bottom:5px
  }

  .intro-page .part-title{
    font-size:1.6rem
  }

  .description{
    font-size:.95rem
  }

  .tab-buttons{
    gap:18px
  }

  .tab-button{
    flex:1;
    min-width:0;
    padding:9px 8px
  }

  .bubble{
    padding:10px 13px
  }

  .bubble-a{
    width:90%
  }

  .bubble-b{
    width:72%
  }

  .bubble-a.speaking{
    padding-right:54px
  }

  .bubble-b.speaking{
    padding-left:54px
  }

  .person-icon{
    width:31px;
    height:31px;
    font-size:1.1rem
  }

  .bubble-a .person-icon{
    right:10px
  }

  .bubble-b .person-icon{
    left:10px
  }

  .read-button{
    width:100%
  }
}

@media(prefers-reduced-motion:reduce){
  html{
    scroll-behavior:auto
  }

  *,
  *::before,
  *::after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    transition-duration:.01ms!important
  }
}
</style>
</head>

<body>

<div class="page-progress-container" aria-hidden="true">
  <div class="page-progress-bar" id="page-progress-bar"></div>
</div>

<!-- ==================================================
     TEIL 1
================================================== -->

<main class="page greeting-page">

  <section aria-labelledby="greeting-title">

    <div class="part-head">
      <span class="part-num">Teil 1</span>
      <h1 class="part-title" id="greeting-title">
        Wir begrüßen uns
      </h1>
    </div>

    <div class="card greeting-card">

      <p class="lead">
        Wir sagen verschiedene Grüße je nach Tageszeit.
        Finde den richtigen Gruß!
      </p>

      <details class="grammar-toggle">

        <summary>Merke! — Grüße nach Tageszeit</summary>

        <div class="grammar-box">
          morgens: <strong>Guten Morgen!</strong><br><br>
          tagsüber: <strong>Guten Tag!</strong><br><br>
          abends: <strong>Guten Abend!</strong><br><br>
          informell: <strong>Hallo!</strong><br><br>
          beim Abschied: <strong>Tschüss!</strong>
        </div>

      </details>

      <div class="greeting-game">

        <div class="clock-display">

          <div
            class="day-picture morgen"
            id="day-picture"
            role="img"
            aria-label="Sonnenaufgang am Morgen"
          >
            <span
              class="day-symbol"
              id="day-symbol"
              aria-hidden="true"
            >
              🌅
            </span>
          </div>

          <span
            class="clock-time"
            id="clock-time"
            aria-live="polite"
          >
            08:00 Uhr
          </span>

        </div>

        <p class="question">
          Welcher Gruß passt zu dieser Uhrzeit?
        </p>

        <div class="answer-buttons">

          <button
            class="answer-button"
            type="button"
            data-gruss="morgen"
          >
            Guten Morgen!
            <span class="click-icon" aria-hidden="true">👆</span>
          </button>

          <button
            class="answer-button"
            type="button"
            data-gruss="tag"
          >
            Guten Tag!
            <span class="click-icon" aria-hidden="true">👆</span>
          </button>

          <button
            class="answer-button"
            type="button"
            data-gruss="abend"
          >
            Guten Abend!
            <span class="click-icon" aria-hidden="true">👆</span>
          </button>

        </div>

        <p
          class="feedback"
          id="greeting-feedback"
          aria-live="polite"
        ></p>

        <p
          class="counter"
          id="greeting-counter"
        >
          Richtige Antworten: 0 / 3
        </p>

        <div class="progress-area" aria-label="Fortschritt">
          <div class="progress-track">
            <div
              class="progress-fill"
              id="progress-fill"
            ></div>
          </div>
        </div>

        <div
          class="finish"
          id="greeting-finish"
          aria-live="polite"
        >
          <span class="finish-title">
            🎉 Sehr gut! Übung geschafft!
          </span>

          Du hast alle drei Grüße richtig erkannt.<br>

          <button
            class="restart-button"
            id="restart-button"
            type="button"
          >
            ↻ Noch einmal
          </button>
        </div>

      </div>

    </div>

  </section>

</main>

<!-- ==================================================
     TEIL 2
================================================== -->

<main class="page intro-page">

  <header class="part-head">
    <span class="part-num">Teil 2</span>
    <h1 class="part-title">Ich stelle mich vor</h1>
  </header>

  <section class="card intro-card">

    <p class="description">
      Trag deinen Namen ein — die Dialoge passen sich an!
    </p>

    <div class="name-row">

      <label for="name-input">
        <span aria-hidden="true">✏️</span>
        <span>Dein Name:</span>
      </label>

      <input
        id="name-input"
        type="text"
        value=""
        placeholder="Dein Name"
        autocomplete="given-name"
      >

    </div>

    <div
      class="tab-buttons"
      role="tablist"
      aria-label="Dialogform auswählen"
    >

      <button
        class="tab-button active"
        id="tab-informell"
        type="button"
        data-dialog="informell"
        role="tab"
        aria-selected="true"
        aria-controls="dialog-informell"
      >
        Informell
        <span class="click-icon" aria-hidden="true">👆</span>
      </button>

      <button
        class="tab-button"
        id="tab-formell"
        type="button"
        data-dialog="formell"
        role="tab"
        aria-selected="false"
        aria-controls="dialog-formell"
      >
        Formell
        <span class="click-icon" aria-hidden="true">👆</span>
      </button>

    </div>

    <div
      class="dialog-box"
      id="dialog-informell"
      role="tabpanel"
      aria-labelledby="tab-informell"
    >

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Hallo!
        <span class="person-icon" aria-hidden="true">👩🏻</span>
      </div>

      <div class="bubble bubble-b">
        <span class="speaker">B</span>
        Wie heißt du?
        <span class="person-icon" aria-hidden="true">🧑🏻</span>
      </div>

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Ich heiße <span class="dynamic-name">…</span>.
        <span class="person-icon" aria-hidden="true">👩🏻</span>
      </div>

      <div class="bubble bubble-b">
        <span class="speaker">B</span>
        Und du?
        <span class="person-icon" aria-hidden="true">🧑🏻</span>
      </div>

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Ich heiße Julia.
        <span class="person-icon" aria-hidden="true">👩🏻</span>
      </div>

    </div>

    <div
      class="dialog-box"
      id="dialog-formell"
      role="tabpanel"
      aria-labelledby="tab-formell"
      hidden
    >

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Guten Tag.
        <span class="person-icon" aria-hidden="true">🧑‍💼</span>
      </div>

      <div class="bubble bubble-b">
        <span class="speaker">B</span>
        Wie heißen Sie?
        <span class="person-icon" aria-hidden="true">👩‍💼</span>
      </div>

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Ich heiße <span class="dynamic-name">…</span>.
        <span class="person-icon" aria-hidden="true">🧑‍💼</span>
      </div>

      <div class="bubble bubble-b">
        <span class="speaker">B</span>
        Und Sie?
        <span class="person-icon" aria-hidden="true">👩‍💼</span>
      </div>

      <div class="bubble bubble-a">
        <span class="speaker">A</span>
        Ich heiße Tom.
        <span class="person-icon" aria-hidden="true">🧑‍💼</span>
      </div>

    </div>

    <button
      class="read-button"
      id="read-button"
      type="button"
    >
      <span aria-hidden="true">🔊</span>
      <span>Dialog vorlesen</span>
    </button>

  </section>

</main>

<!-- ==================================================
     TEIL 3 – INFORMELL ODER FORMELL
================================================== -->

<main class="page exercise-page">

  <section class="exercise-card">

    <button
      type="button"
      class="exercise-read-button"
      id="exercise-read-button"
    >
      🔊 Dialog vorlesen
    </button>

    <h1 class="exercise-title">
      Informell oder formell?
    </h1>

    <div class="category-buttons">

      <button
        type="button"
        class="category-button"
        data-category="informell"
      >
        Informell
        <span class="click-icon" aria-hidden="true">👆</span>
      </button>

      <button
        type="button"
        class="category-button"
        data-category="formell"
      >
        Formell
        <span class="click-icon" aria-hidden="true">👆</span>
      </button>

    </div>

    <div class="exercise-list">

      <div
        class="exercise-row active"
        data-answer="informell"
        data-text="Wie heißt du?"
      >
        <span class="exercise-sentence">Wie heißt du?</span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="formell"
        data-text="Wie heißen Sie?"
      >
        <span class="exercise-sentence">Wie heißen Sie?</span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="formell"
        data-text="Mein Name ist Anna Müller."
      >
        <span class="exercise-sentence">
          Mein Name ist Anna Müller.
        </span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="informell"
        data-text="Hallo! Ich bin Tom."
      >
        <span class="exercise-sentence">
          Hallo! Ich bin Tom.
        </span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="informell"
        data-text="Hallo!"
      >
        <span class="exercise-sentence">Hallo!</span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="informell"
        data-text="Tschüss!"
      >
        <span class="exercise-sentence">Tschüss!</span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

      <div
        class="exercise-row"
        data-answer="formell"
        data-text="Guten Tag!"
      >
        <span class="exercise-sentence">Guten Tag!</span>
        <p class="exercise-feedback" aria-live="polite"></p>
      </div>

    </div>

    <div class="exercise-result">

      <p class="exercise-score">
        Richtig zugeordnet:
        <strong>
          <span id="exercise-score">0</span> / 7
        </strong>
      </p>

      <button
        type="button"
        class="exercise-reset"
        id="exercise-reset"
      >
        Übung wiederholen
      </button>

    </div>

    <p
      class="exercise-complete"
      id="exercise-complete"
      aria-live="polite"
    ></p>

  </section>

</main>

<script>
"use strict";

const byId=id=>document.getElementById(id);
const synth=window.speechSynthesis;

let germanVoice=null;
let speechVersion=0;

/* ==================================================
   PASEK POSTĘPU
================================================== */

function updatePageProgress(){
  const maximum=
    document.documentElement.scrollHeight-
    window.innerHeight;

  const position=
    window.scrollY||
    document.documentElement.scrollTop;

  const progress=maximum<=0
    ?100
    :Math.min(100,Math.max(0,position/maximum*100));

  byId("page-progress-bar").style.width=
    `${progress}%`;
}

window.addEventListener(
  "scroll",
  updatePageProgress,
  {passive:true}
);

window.addEventListener(
  "resize",
  updatePageProgress
);

updatePageProgress();

/* ==================================================
   GŁOS NIEMIECKI
================================================== */

function loadVoice(){
  if(!synth)return;

  const voices=synth.getVoices();

  germanVoice=
    voices.find(voice=>
      voice.lang?.toLowerCase()==="de-de"&&
      voice.name?.toLowerCase().includes("google")
    )||
    voices.find(voice=>
      voice.lang?.toLowerCase()==="de-de"
    )||
    voices.find(voice=>
      voice.lang?.toLowerCase().startsWith("de")
    )||
    null;
}

loadVoice();

synth?.addEventListener(
  "voiceschanged",
  loadVoice
);

function cancelSpeech(){
  speechVersion++;
  synth?.cancel();
}

function speak(text,rate=.92){
  return new Promise(resolve=>{
    if(!synth||!text){
      resolve();
      return;
    }

    const utterance=
      new SpeechSynthesisUtterance(text);

    utterance.lang="de-DE";
    utterance.rate=rate;
    utterance.pitch=1;
    utterance.volume=1;

    if(germanVoice){
      utterance.voice=germanVoice;
    }

    utterance.onend=resolve;

    utterance.onerror=event=>{
      if(
        !["canceled","interrupted"]
          .includes(event.error)
      ){
        console.error(
          "Fehler bei der Sprachausgabe:",
          event.error
        );
      }

      resolve();
    };

    synth.speak(utterance);
  });
}

const wait=milliseconds=>
  new Promise(resolve=>
    setTimeout(resolve,milliseconds)
  );

/* ==================================================
   TEIL 1
================================================== */

const greetingButtons=[
  ...document.querySelectorAll(".answer-button")
];

const greetingTasks=[
  [8,"morgen","🌅","Sonnenaufgang am Morgen","Guten Morgen!"],
  [13,"tag","☀️","Sonniger Tag","Guten Tag!"],
  [19,"abend","🌙","Mond am Abend","Guten Abend!"]
];

let greetingIndex=0;
let greetingScore=0;
let greetingLocked=false;

function setGreetingButtons(disabled){
  greetingButtons.forEach(button=>{
    button.disabled=disabled;

    if(!disabled){
      button.classList.remove(
        "richtig",
        "falsch"
      );
    }
  });
}

function updateGreetingProgress(){
  byId("greeting-counter").textContent=
    `Richtige Antworten: ${greetingScore} / ${greetingTasks.length}`;

  byId("progress-fill").style.width=
    `${greetingScore/greetingTasks.length*100}%`;
}

function showGreetingTask(){
  const [hour,key,icon,label]=
    greetingTasks[greetingIndex];

  greetingLocked=false;

  byId("greeting-feedback").textContent="";
  byId("greeting-feedback").style.color="";

  setGreetingButtons(false);

  byId("clock-time").textContent=
    `${String(hour).padStart(2,"0")}:00 Uhr`;

  byId("day-picture").className=
    `day-picture ${key}`;

  byId("day-picture").setAttribute(
    "aria-label",
    label
  );

  byId("day-symbol").textContent=icon;
  byId("day-symbol").style.transform="scale(.75)";

  setTimeout(()=>{
    byId("day-symbol").style.transform="scale(1)";
  },60);
}

function nextGreetingTask(){
  greetingIndex++;

  if(greetingIndex<greetingTasks.length){
    showGreetingTask();
    return;
  }

  greetingLocked=true;
  setGreetingButtons(true);

  byId("greeting-feedback").style.color="#28502f";
  byId("greeting-feedback").textContent=
    "Alle Antworten sind richtig!";

  byId("greeting-finish").classList.add("zeigen");

  cancelSpeech();

  speak(
    "Sehr gut! Du hast alle drei Antworten richtig.",
    .9
  );
}

greetingButtons.forEach(button=>{
  button.addEventListener("click",()=>{
    if(greetingLocked)return;

    const [,key,,,answer]=
      greetingTasks[greetingIndex];

    greetingButtons.forEach(item=>{
      item.classList.remove(
        "richtig",
        "falsch"
      );
    });

    if(button.dataset.gruss!==key){
      button.classList.add("falsch");

      byId("greeting-feedback").style.color=
        "#bd4433";

      byId("greeting-feedback").textContent=
        "Versuch es noch einmal!";

      cancelSpeech();

      speak(
        "Nicht ganz. Versuch es noch einmal.",
        .9
      );

      return;
    }

    greetingLocked=true;
    greetingScore++;

    button.classList.add("richtig");
    setGreetingButtons(true);

    byId("greeting-feedback").style.color=
      "#28502f";

    byId("greeting-feedback").textContent=
      `Richtig! ${answer}`;

    updateGreetingProgress();

    cancelSpeech();
    speak(answer,.9);

    setTimeout(nextGreetingTask,1200);
  });
});

byId("restart-button").addEventListener(
  "click",
  ()=>{
    greetingIndex=0;
    greetingScore=0;
    greetingLocked=false;

    byId("greeting-finish")
      .classList.remove("zeigen");

    updateGreetingProgress();
    showGreetingTask();
  }
);

/* ==================================================
   TEIL 2
================================================== */

const nameInput=byId("name-input");

const dynamicNames=
  document.querySelectorAll(".dynamic-name");

const tabs=
  document.querySelectorAll(".tab-button");

const dialogReadButton=
  byId("read-button");

const dialogs={
  informell:byId("dialog-informell"),
  formell:byId("dialog-formell")
};

let activeDialog="informell";
let readingDialog=false;

function updateName(){
  const name=nameInput.value.trim()||"…";

  dynamicNames.forEach(element=>{
    element.textContent=name;
  });
}

function clearSpeakingBubbles(){
  document
    .querySelectorAll(".bubble.speaking")
    .forEach(bubble=>{
      bubble.classList.remove("speaking");
    });
}

function resetDialogReadButton(){
  dialogReadButton.disabled=false;
  dialogReadButton.innerHTML=
    "🔊 <span>Dialog vorlesen</span>";
}

function getBubbleText(bubble){
  const copy=bubble.cloneNode(true);

  copy.querySelector(".speaker")?.remove();
  copy.querySelector(".person-icon")?.remove();

  return copy.textContent
    .replace(/\s+/g," ")
    .trim();
}

nameInput.addEventListener(
  "input",
  updateName
);

updateName();

tabs.forEach(button=>{
  button.addEventListener("click",()=>{
    readingDialog=false;

    cancelSpeech();
    clearSpeakingBubbles();

    activeDialog=button.dataset.dialog;

    tabs.forEach(tab=>{
      const active=tab===button;

      tab.classList.toggle("active",active);

      tab.setAttribute(
        "aria-selected",
        String(active)
      );
    });

    Object.entries(dialogs).forEach(
      ([name,dialog])=>{
        dialog.hidden=name!==activeDialog;
      }
    );

    resetDialogReadButton();
  });
});

dialogReadButton.addEventListener(
  "click",
  async()=>{
    if(!synth){
      alert(
        "Ihr Browser unterstützt die Sprachausgabe nicht."
      );

      return;
    }

    cancelSpeech();
    clearSpeakingBubbles();

    readingDialog=true;
    dialogReadButton.disabled=true;
    dialogReadButton.innerHTML=
      "🔊 <span>Dialog wird vorgelesen …</span>";

    const localVersion=speechVersion;

    const bubbles=[
      ...dialogs[activeDialog]
        .querySelectorAll(".bubble")
    ];

    for(const bubble of bubbles){
      if(
        !readingDialog||
        localVersion!==speechVersion
      ){
        break;
      }

      clearSpeakingBubbles();
      bubble.classList.add("speaking");

      await speak(
        getBubbleText(bubble)
      );

      bubble.classList.remove("speaking");
    }

    clearSpeakingBubbles();
    readingDialog=false;
    resetDialogReadButton();
  }
);

/* ==================================================
   TEIL 3
================================================== */

const exerciseRows=[
  ...document.querySelectorAll(".exercise-row")
];

const categoryButtons=[
  ...document.querySelectorAll(".category-button")
];

const exerciseReadButton=
  byId("exercise-read-button");

const exerciseScoreElement=
  byId("exercise-score");

const exerciseComplete=
  byId("exercise-complete");

let exerciseIndex=0;
let exerciseScore=0;
let exerciseLocked=false;

function showCurrentExercise(){
  exerciseRows.forEach((row,index)=>{
    row.classList.toggle(
      "active",
      index===exerciseIndex
    );
  });

  exerciseRows[exerciseIndex]?.scrollIntoView({
    behavior:"smooth",
    block:"nearest"
  });
}

function setCategoryButtons(enabled){
  exerciseLocked=!enabled;

  categoryButtons.forEach(button=>{
    button.disabled=!enabled;

    button.classList.remove(
      "correct-choice",
      "wrong-choice"
    );
  });
}

categoryButtons.forEach(button=>{
  button.addEventListener("click",async()=>{
    if(
      exerciseLocked||
      exerciseIndex>=exerciseRows.length
    ){
      return;
    }

    exerciseLocked=true;
    cancelSpeech();

    const row=
      exerciseRows[exerciseIndex];

    const feedback=
      row.querySelector(".exercise-feedback");

    const correct=
      button.dataset.category===
      row.dataset.answer;

    categoryButtons.forEach(item=>{
      item.classList.remove(
        "correct-choice",
        "wrong-choice"
      );
    });

    feedback.textContent="";
    feedback.className="exercise-feedback";

    row.classList.remove("wrong");

    if(correct){
      categoryButtons.forEach(item=>{
        item.disabled=true;
      });

      button.classList.add("correct-choice");

      row.classList.remove("active");
      row.classList.add("solved");

      feedback.textContent=
        "Richtig! Sehr gut.";

      feedback.classList.add("good");

      exerciseScore++;

      exerciseScoreElement.textContent=
        String(exerciseScore);

      await speak(
        "Richtig! Sehr gut.",
        .9
      );

      await wait(250);

      exerciseIndex++;

      if(exerciseIndex<exerciseRows.length){
        setCategoryButtons(true);
        showCurrentExercise();
      }else{
        setCategoryButtons(false);

        exerciseComplete.textContent=
          "Sehr gut! Alle Sätze sind richtig zugeordnet.";

        await speak(
          "Sehr gut! Alle Sätze sind richtig zugeordnet.",
          .88
        );
      }

      return;
    }

    button.classList.add("wrong-choice");
    row.classList.add("wrong");

    feedback.textContent=
      "Nicht ganz. Versuchen Sie es noch einmal.";

    feedback.classList.add("bad");

    await speak(
      "Nicht ganz. Versuchen Sie es noch einmal.",
      .88
    );

    await wait(250);

    row.classList.remove("wrong");
    button.classList.remove("wrong-choice");
    exerciseLocked=false;
  });
});

/* Dialog vorlesen działa zawsze */

exerciseReadButton.addEventListener(
  "click",
  async()=>{
    cancelSpeech();

    const localVersion=speechVersion;

    exerciseReadButton.classList.add("speaking");

    for(const row of exerciseRows){
      if(localVersion!==speechVersion){
        break;
      }

      const oldBorder=
        row.style.borderColor;

      const oldTransform=
        row.style.transform;

      row.style.borderColor="#cf9f3f";
      row.style.transform="scale(1.01)";

      await speak(
        row.dataset.text,
        .86
      );

      row.style.borderColor=oldBorder;
      row.style.transform=oldTransform;

      if(localVersion!==speechVersion){
        break;
      }

      await wait(180);
    }

    exerciseReadButton.classList.remove("speaking");
  }
);

byId("exercise-reset").addEventListener(
  "click",
  ()=>{
    cancelSpeech();

    exerciseIndex=0;
    exerciseScore=0;
    exerciseLocked=false;

    exerciseScoreElement.textContent="0";
    exerciseComplete.textContent="";

    categoryButtons.forEach(button=>{
      button.disabled=false;

      button.classList.remove(
        "correct-choice",
        "wrong-choice"
      );
    });

    exerciseRows.forEach((row,index)=>{
      row.classList.remove(
        "active",
        "solved",
        "wrong"
      );

      row.style.cssText="";

      if(index===0){
        row.classList.add("active");
      }

      const feedback=
        row.querySelector(".exercise-feedback");

      feedback.textContent="";
      feedback.className="exercise-feedback";
    });

    showCurrentExercise();
  }
);

/* ==================================================
   START I ZATRZYMANIE
================================================== */

window.addEventListener(
  "beforeunload",
  ()=>{
    readingDialog=false;
    cancelSpeech();
    clearSpeakingBubbles();
  }
);

updateGreetingProgress();
showGreetingTask();
showCurrentExercise();
</script>

</body>
  </html>
