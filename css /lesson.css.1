:root {
    --bg: #20324a;
    --bg-soft: #27405c;
    --paper: #fbf6ec;
    --ink: #23332e;

    --chalk: #1d2b39;
    --chalk-light: #2a3b50;

    --gold: #f4c95d;
    --green: #8bd17c;
    --blue: #72b8ff;
    --pink: #f08bb4;
    --orange: #f29f67;

    --line: rgba(35, 51, 46, 0.18);
}
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--bg);
    background-image:
        radial-gradient(circle at 12% 10%, rgba(255,255,255,.05), transparent 35%),
        radial-gradient(circle at 88% 90%, rgba(255,255,255,.05), transparent 40%);
    color: var(--ink);
    font-family: "Nunito Sans", sans-serif;
    line-height: 1.6;
    padding: 0 0 60px;
}

