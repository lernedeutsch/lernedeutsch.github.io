:root {
    --bg: #20324a;
    --text: #111820;
    --muted: #2a3b50;
    --border: #dce3ed;
    --gold: #f4c95d;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 0 0 60px;
    background: var(--bg);
    color: var(--text);
    font-family: "Nunito Sans", sans-serif;
    line-height: 1.6;
}

.top-bar,
.course-nav,
.wrap {
    max-width: 980px;
    margin-left: auto;
    margin-right: auto;
}

/* =========================
   PRZYCISK A-Z
   ========================= */

.top-bar {
    padding: 20px;
}

.aza1-btn,
.lesson-nav a,
.back-to-top,
.übung-btn {
    display: inline-flex;
    text-decoration: none;
    border-radius: 999px;
}

.aza1-btn {
    padding: 14px 28px;
    background: #1d3557;
    color: #ffce00;
    border: 3px solid #ffce00;
    font-size: 30px;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition:
        background 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease;
}

.aza1-btn:hover {
    background: #274c77;
    color: #ffffff;
    transform: translateY(-3px) scale(1.05);
}

/* =========================
   SPIS TREŚCI
   ========================= */

.course-nav {
    padding: 0 20px 30px;
}

.course-nav-title {
    margin: 0 0 24px;
    font-family: "Kalam", cursive;
    font-size: 2.2rem;
    text-align: center;
}

.course-section,
.card {
    background: #f7f9fc;
    border: 1px solid var(--border);
    border-radius: 18px;
}

.course-section {
    margin-bottom: 16px;
    padding: 16px 18px;
}

.section-title {
    margin: 0 0 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.lesson-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.lesson-list a {
    display: block;
    padding: 10px 12px;
    background: #ffffff;
    color: #111820;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition:
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
}

.lesson-list a:hover {
    background: #f0f4f8;
    color: #0a1220;
    border-color: var(--gold);
    transform: translateX(4px);
}

/* =========================
   GŁÓWNY KONTENER LEKCJI
   ========================= */

section[id^="lektion"] {
    scroll-margin-top: 40px;
}

.wrap {
    padding: 32px;
    border-radius: 22px;
}

/* =========================
   KOLORY LEKCJI 1–11
   ========================= */

.lesson-theme-1 {
    background: linear-gradient(
        135deg,
        #fff5e6,
        #ffe0b2
    );
}

.lesson-theme-2 {
    background: linear-gradient(
        135deg,
        #e8f5e9,
        #c8e6c9
    );
}

.lesson-theme-3 {
    background: linear-gradient(
        135deg,
        #f3e8d4,
        #f9e8c9
    );
}

.lesson-theme-4 {
    background: linear-gradient(
        135deg,
        #e3f2fd,
        #bbdefb
    );
}

.lesson-theme-5 {
    background: linear-gradient(
        135deg,
        #f3e5f5,
        #e1bee7
    );
}

.lesson-theme-6 {
    background: linear-gradient(
        135deg,
        #fff3e0,
        #ffe0b2
    );
}

.lesson-theme-7 {
    background: linear-gradient(
        135deg,
        #e0f2f1,
        #b2dfdb
    );
}

.lesson-theme-8 {
    background: linear-gradient(
        135deg,
        #fce4ec,
        #f8bbd0
    );
}

.lesson-theme-9 {
    background: linear-gradient(
        135deg,
        #fff8e1,
        #ffecb3
    );
}

.lesson-theme-10 {
    background: linear-gradient(
        135deg,
        #e1f5fe,
        #b3e5fc
    );
}

.lesson-theme-11 {
    background: linear-gradient(
        135deg,
        #f0f4c3,
        #e6ee9c
    );
}

/* =========================
   NAGŁÓWEK LEKCJI
   ========================= */

.hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    padding-bottom: 28px;
    border-bottom: 2px dashed rgba(35, 51, 46, 0.18);
}

.hero-text {
    flex: 1 1 340px;
}

.eyebrow {
    margin: 0 0 10px;
    color: #b8860b;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

h1.lesson-title {
    margin: 0 0 14px;
    font-family: "Kalam", cursive;
    font-size: 2.7rem;
    line-height: 1.12;
}

.hero-text p {
    max-width: 55ch;
    margin: 0;
    color: var(--muted);
}

.topics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.topics span {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    background: #f0f4f8;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.92rem;
}

/* =========================
   GRAFIKA SVG W NAGŁÓWKU
   ========================= */

.wheel-box {
    flex: 0 1 280px;
}

.wheel-box svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(
        0 16px 30px rgba(0, 0, 0, 0.18)
    );
}

.center-label,
.center-sub,
.month-label {
    font-family: "JetBrains Mono", monospace;
    text-anchor: middle;
}

.center-label {
    font-size: 18px;
    font-weight: 700;
}

.center-sub {
    font-size: 13px;
}

.month-label {
    font-size: 13px;
}
