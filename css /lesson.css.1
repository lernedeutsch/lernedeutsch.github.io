:root {
    --bg: #20324a;
    --bg-soft: #27405c;
    --paper: #fbf6ec;
    --ink: #23332e;

    --chalk: #1d2b39;
    --chalk-light: #2a3b50;

    --gold: #f4c95d;
    --green: #8bd17c;
    --blue: #72b8ff;
    --pink: #f08bb4;
    --orange: #f29f67;

    --line: rgba(35, 51, 46, 0.18);
}
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--bg);
    background-image:
        radial-gradient(circle at 12% 10%, rgba(255,255,255,.05), transparent 35%),
        radial-gradient(circle at 88% 90%, rgba(255,255,255,.05), transparent 40%);
    color: var(--ink);
    font-family: "Nunito Sans", sans-serif;
    line-height: 1.6;
    padding: 0 0 60px;
}

.course-nav {
    max-width: 880px;
    margin: 40px auto 60px;
}
.course-nav {
    max-width: 880px;
    margin: 40px auto 60px;
    padding: 0 20px;
}

.course-nav-title {
    font-family: "Kalam", cursive;
    font-size: 2.2rem;
    margin: 0 0 24px;
    color: #111820;
    text-align: center;
}

.course-section {
    background: #f7f9fc;
    border: 1px solid #dce3ed;
    border-radius: 18px;
    padding: 16px 18px 14px;
    margin-bottom: 16px;
}

.section-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 1rem;
     letter-spacing: .12em;
    text-transform: uppercase;
    color: #111820;
    margin: 0 0 12px;
}
.lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
}
.lesson-list a {
    display: block;
    color: #111820;
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 12px;
    background: #ffffff;
     border: 1px solid #dce3ed;
    transition: background .15s ease,
                border-color .15s ease,
                transform .15s ease;
}
.lesson-list a:hover {
    background: #f0f4f8;
    border-color: #f4c95d;
    transform: translateX(4px);
    color: #0a1220;
}

section[id^="lektion"] {
    scroll-margin-top: 40px;
}

.wrap {
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 20px 0;
}

header.hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    padding: 24px 0 36px;
    border-bottom: 2px dashed rgba(35, 51, 46, .18);
    margin-bottom: 36px;
}
.hero-text {
    flex: 1 1 340px;
}

.eyebrow {
    font-family: "JetBrains Mono", monospace;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-size: .78rem;
    color: #f4c95d;
    margin: 0 0 10px;
}

h1.lesson-title {
    font-family: "Kalam", cursive;
    font-weight: 700;
    font-size: 2.7rem;
    line-height: 1.12;
    margin: 0 0 14px;
    color: #111820;
}

.hero-text p {
    margin: 0;
    color: #2a3b50;
    max-width: 52ch;
}

.topics {
