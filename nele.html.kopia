<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mit Nele sprechen</title>

    <style>
        :root {
            --background: #071426;
            --panel: rgba(13, 31, 54, 0.92);
            --panel-soft: rgba(21, 45, 75, 0.78);
            --border: rgba(118, 177, 255, 0.18);
            --text: #f6f9ff;
            --muted: #aebcd1;
            --blue: #168cff;
            --blue-dark: #0b63df;
            --shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            color: var(--text);
            font-family: Arial, Helvetica, sans-serif;
            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(21, 96, 180, 0.18),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 85% 10%,
                    rgba(34, 120, 255, 0.12),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    #06101f 0%,
                    #0b1f38 48%,
                    #071426 100%
                );
        }

        button,
        input {
            font: inherit;
        }

        .page {
            width: min(1500px, 100%);
            min-height: 100vh;
            margin: 0 auto;
            padding: 24px;
            display: grid;
            grid-template-rows: auto 1fr auto;
            gap: 18px;
        }

        .topbar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: start;
            gap: 20px;
        }

        .back-link,
        .settings-button {
            min-height: 54px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0 20px;
            border: 1px solid var(--border);
            border-radius: 16px;
            color: var(--text);
            text-decoration: none;
            background: rgba(12, 29, 50, 0.78);
            box-shadow: var(--shadow);
            transition:
                transform 0.2s ease,
                background 0.2s ease;
        }

        .back-link {
            justify-self: start;
        }

        .settings-button {
            justify-self: end;
            cursor: pointer;
        }

        .back-link:hover,
        .settings-button:hover {
            transform: translateY(-2px);
            background: rgba(21, 48, 80, 0.95);
        }

        .page-title {
            text-align: center;
        }

        .page-title h1 {
            font-size: clamp(34px, 4vw, 58px);
            line-height: 1.05;
            letter-spacing: -1px;
        }

        .page-title p {
            margin-top: 10px;
            color: var(--muted);
            font-size: clamp(16px, 1.8vw, 21px);
        }

        .main-layout {
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(300px, 0.78fr) minmax(460px, 1.65fr);
            gap: 22px;
        }

        .avatar-panel,
        .chat-panel,
        .controls-panel {
            border: 1px solid var(--border);
            border-radius: 24px;
            background:
                linear-gradient(
                    180deg,
                    rgba(15, 35, 61, 0.96),
                    rgba(8, 24, 43, 0.96)
                );
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .avatar-panel {
            position: relative;
            min-height: 640px;
            background:
                radial-gradient(
                    circle at 50% 25%,
                    rgba(44, 122, 217, 0.22),
                    transparent 36%
                ),
                linear-gradient(
                    180deg,
                    rgba(7, 25, 44, 0.94),
                    rgba(5, 17, 31, 0.98)
                );
        }

        .avatar-glow {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(
                    circle at 50% 55%,
                    transparent 32%,
                    rgba(3, 13, 24, 0.3) 75%
                );
            z-index: 2;
        }

        .avatar-frame {
            width: 100%;
            height: 100%;
            min-height: 640px;
            border: 0;
            display: block;
            background: transparent;
        }

        .avatar-card {
            position: absolute;
            left: 20px;
            bottom: 20px;
            z-index: 3;
            width: min(310px, calc(100% - 40px));
            padding: 18px 20px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: rgba(9, 25, 44, 0.9);
            backdrop-filter: blur(14px);
        }

        .avatar-card strong {
            display: block;
            margin-bottom: 8px;
            font-size: 20px;
        }

        .avatar-card p {
            color: var(--muted);
            line-height: 1.55;
        }

        .online-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            margin-right: 8px;
            border-radius: 50%;
            background: #2f9cff;
            box-shadow: 0 0 14px rgba(47, 156, 255, 0.85);
        }

        .chat-panel {
            min-height: 640px;
            display: grid;
            grid-template-rows: 1fr auto;
        }

        .messages {
            min-height: 0;
            padding: 28px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .message {
            max-width: 72%;
            padding: 17px 19px;
            border-radius: 20px;
            line-height: 1.55;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.17);
        }

        .message.nele {
            align-self: flex-start;
            background: var(--panel-soft);
            border-top-left-radius: 6px;
        }

        .message.user {
            align-self: flex-end;
            background:
                linear-gradient(
                    135deg,
                    #148cff,
                    #1265e9
                );
            border-top-right-radius: 6px;
        }

        .message-author {
            display: block;
            margin-bottom: 7px;
            color: #58aaff;
            font-weight: bold;
        }

        .message.user .message-author {
            color: #dfeeff;
        }

        .typing {
            align-self: flex-start;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border-radius: 16px;
            color: var(--muted);
            background: rgba(24, 49, 79, 0.72);
        }

        .typing-dots {
            display: inline-flex;
            gap: 5px;
        }

        .typing-dots span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #438fe8;
            animation: dotPulse 1.2s infinite ease-in-out;
        }

        .typing-dots span:nth-child(2) {
            animation-delay: 0.15s;
        }

        .typing-dots span:nth-child(3) {
            animation-delay: 0.3s;
        }

        @keyframes dotPulse {
            0%,
            100% {
                opacity: 0.35;
                transform: translateY(0);
            }

            50% {
                opacity: 1;
                transform: translateY(-3px);
            }
        }

        .message-form {
            padding: 18px 20px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 14px;
            border-top: 1px solid var(--border);
            background: rgba(8, 24, 43, 0.92);
        }

        .message-input {
            width: 100%;
            min-height: 56px;
            padding: 0 18px;
            border: 1px solid rgba(118, 177, 255, 0.3);
            border-radius: 14px;
            outline: none;
            color: white;
            background: rgba(16, 37, 63, 0.9);
        }

        .message-input::placeholder {
            color: #8fa1b8;
        }

        .message-input:focus {
            border-color: #2f93ff;
            box-shadow: 0 0 0 3px rgba(47, 147, 255, 0.13);
        }

        .send-button {
            min-width: 132px;
            border: 0;
            border-radius: 14px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            background:
                linear-gradient(
                    135deg,
                    #168cff,
                    #0d63e8
                );
            transition:
                transform 0.2s ease,
                filter 0.2s ease;
        }

        .send-button:hover {
            transform: translateY(-2px);
            filter: brightness(1.08);
        }

        .controls-panel {
            padding: 20px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 24px;
        }

        .secondary-control {
            justify-self: center;
            min-height: 54px;
            padding: 0 20px;
            border: 1px solid var(--border);
            border-radius: 15px;
            color: white;
            cursor: pointer;
            background: rgba(17, 37, 64, 0.82);
        }

        .microphone-area {
            text-align: center;
        }

        .microphone-button {
            width: 116px;
            height: 116px;
            border: 7px solid rgba(28, 113, 255, 0.24);
            border-radius: 50%;
            color: white;
            font-size: 50px;
            cursor: pointer;
            background:
                linear-gradient(
                    135deg,
                    #209dff,
                    #1262ec
                );
            box-shadow:
                0 0 0 10px rgba(27, 115, 255, 0.12),
                0 0 45px rgba(21, 111, 255, 0.45);
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .microphone-button:hover {
            transform: scale(1.04);
            box-shadow:
                0 0 0 12px rgba(27, 115, 255, 0.14),
                0 0 56px rgba(21, 111, 255, 0.58);
        }

        .microphone-label {
            margin-top: 12px;
            color: #91b8eb;
        }

        .tip-bar {
            grid-column: 1 / -1;
            margin-top: 2px;
            padding: 14px 18px;
            border-radius: 14px;
            color: var(--muted);
            background: rgba(13, 31, 54, 0.88);
        }

        @media (max-width: 1000px) {
            .topbar {
                grid-template-columns: 1fr 1fr;
            }

            .page-title {
                grid-column: 1 / -1;
                grid-row: 1;
            }

            .back-link {
                grid-column: 1;
                grid-row: 2;
            }

            .settings-button {
                grid-column: 2;
                grid-row: 2;
            }

            .main-layout {
                grid-template-columns: 1fr;
            }

            .avatar-panel {
                min-height: 520px;
            }

            .avatar-frame {
                min-height: 520px;
            }

            .chat-panel {
                min-height: 580px;
            }
        }

        @media (max-width: 700px) {
            .page {
                padding: 12px;
            }

            .topbar {
                gap: 12px;
            }

            .back-link,
            .settings-button {
                min-height: 48px;
                padding: 0 14px;
                font-size: 14px;
            }

            .main-layout {
                gap: 14px;
            }

            .avatar-panel,
            .chat-panel,
            .controls-panel {
                border-radius: 18px;
            }

            .avatar-panel {
                min-height: 430px;
            }

            .avatar-frame {
                min-height: 430px;
            }

            .avatar-card {
                left: 12px;
                bottom: 12px;
                width: calc(100% - 24px);
            }

            .chat-panel {
                min-height: 520px;
            }

            .messages {
                padding: 16px;
            }

            .message {
                max-width: 88%;
            }

            .message-form {
                grid-template-columns: 1fr;
            }

            .send-button {
                min-height: 50px;
            }

            .controls-panel {
                grid-template-columns: 1fr;
            }

            .secondary-control {
                width: 100%;
            }

            .microphone-area {
                grid-row: 1;
            }

            .tip-bar {
                grid-column: 1;
            }
        }
    </style>
</head>

<body>

    <div class="page">

        <header class="topbar">

            <a
                href="mapa-niemiec.html"
                class="back-link"
            >
                ← Zurück zur Karte
            </a>

            <div class="page-title">
                <h1>Mit Nele sprechen 💬</h1>

                <p>
                    Deutsch sprechen üben – ganz einfach mit Nele
                </p>
            </div>

            <button
                type="button"
                class="settings-button"
            >
                ⚙ Einstellungen
            </button>

        </header>

        <main class="main-layout">

            <section
                class="avatar-panel"
                aria-label="Nele"
            >

                <iframe
                    src="avatar/avatar.html"
                    title="Nele – Deutschtrainerin"
                    class="avatar-frame"
                ></iframe>

                <div class="avatar-glow"></div>

                <div class="avatar-card">
                    <strong>
                        <span class="online-dot"></span>
                        Nele
                    </strong>

                    <p>
                        Deine Deutschtrainerin
                    </p>

                    <p>
                        Geduldig • Freundlich • Hilfsbereit
                    </p>
                </div>

            </section>

            <section
                class="chat-panel"
                aria-label="Gespräch mit Nele"
            >

                <div
                    class="messages"
                    id="chatMessages"
                >

                    <article class="message nele">
                        <span class="message-author">
                            Nele
                        </span>

                        Guten Tag!<br>
                        Schön, dass du da bist.<br>
                        Worüber möchtest du heute sprechen?
                    </article>

                    <article class="message user">
                        <span class="message-author">
                            Du
                        </span>

                        Guten Tag, Nele!<br>
                        Ich möchte über meine Arbeit sprechen.
                    </article>

                    <article class="message nele">
                        <span class="message-author">
                            Nele
                        </span>

                        Sehr gut!<br>
                        Erzähl mir, was machst du beruflich?
                    </article>

                    <div class="typing">
                        <span class="typing-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>

                        Nele schreibt …
                    </div>

                </div>

                <form
                    class="message-form"
                    id="messageForm"
                >

                    <input
                        type="text"
                        id="messageInput"
                        class="message-input"
                        placeholder="Schreibe deine Nachricht …"
                        autocomplete="off"
                    >

                    <button
                        type="submit"
                        class="send-button"
                    >
                        Senden ✈
                    </button>

                </form>

            </section>

        </main>

        <section class="controls-panel">

            <button
                type="button"
                class="secondary-control"
            >
                ⌨ Tastatur verwenden
            </button>

            <div class="microphone-area">

                <button
                    type="button"
                    id="neleMicrophoneButton"
                    class="microphone-button"
                    aria-label="Mit Nele sprechen"
                >
                    🎤
                </button>

                <p class="microphone-label">
                    Zum Sprechen klicken
                </p>

            </div>

            <button
                type="button"
                class="secondary-control"
            >
                🔊 Letzte Antwort wiederholen
            </button>

            <div class="tip-bar">
                ℹ <strong>Tipp:</strong>
                Sprich langsam und deutlich.
                Nele versteht dich und hilft dir,
                besser Deutsch zu sprechen.
            </div>

        </section>

    </div>

    <script src="js/nele-voice.js"></script>

    <script>
        const messageForm =
            document.getElementById("messageForm");

        const messageInput =
            document.getElementById("messageInput");

        const chatMessages =
            document.getElementById("chatMessages");

        const microphoneButton =
            document.getElementById(
                "neleMicrophoneButton"
            );

        messageForm.addEventListener(
            "submit",
            function (event) {
                event.preventDefault();

                const text =
                    messageInput.value.trim();

                if (!text) {
                    return;
                }

                const message =
                    document.createElement("article");

                message.className =
                    "message user";

                message.innerHTML =
                    "<span class=\"message-author\">" +
                    "Du" +
                    "</span>" +
                    text;

                chatMessages.appendChild(message);

                messageInput.value = "";

                chatMessages.scrollTop =
                    chatMessages.scrollHeight;
            }
        );

        microphoneButton.addEventListener(
            "click",
            function () {
                if (
                    typeof window.startNeleListening
                    === "function"
                ) {
                    window.startNeleListening();
                }
            }
        );
    </script>

</body>

</html>
